PORT=4000
# Comma-separated frontend origins allowed to call the API.
# Unset = reflect any origin — dev only, tighten before deploying.
CORS_ALLOWED_ORIGINS=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
CRYPTOPANIC_API_KEY=
ML_SERVICE_URL=http://localhost:8000
# Shared secret between backend and ml-service. When set, the ml-service
# requires X-API-Key header on every /predict/* request. Leave empty for
# local dev (ml-service skips auth when unset).
ML_SERVICE_API_KEY=
# UNVERIFIED whether Alpha Vantage's free tier covers this -- see
# docs/superpowers/specs/2026-08-13-xau-market-signal-design.md
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
